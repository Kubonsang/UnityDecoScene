.window-scroll{flex-grow:1;padding:16px 16px 24px;background-color:rgb(24,27,33)}
.hero-card{padding:22px;margin-bottom:14px;border-width:1px;border-color:rgb(84,67,112);border-radius:12px;background-color:rgb(38,32,48)}
.eyebrow{margin-bottom:5px;color:rgb(198,173,231);font-size:10px;-unity-font-style:bold;letter-spacing:1px}.hero-title{margin-bottom:7px;color:rgb(244,245,249);font-size:23px;-unity-font-style:bold}.hero-description{max-width:680px;margin-bottom:13px;color:rgb(194,199,209);white-space:normal;font-size:12px}
.safety-row,.button-row,.button-wrap,.stepper{flex-direction:row;align-items:center}.safety-row,.button-wrap{flex-wrap:wrap}.safety-chip{margin:0 7px 4px 0;padding:4px 9px;border-radius:10px;background-color:rgba(19,22,29,.66);color:rgb(187,195,207);font-size:10px}
.stepper{justify-content:center;margin-bottom:14px;padding:8px 0}.step-item{align-items:center;min-width:72px}.step-number{width:24px;height:24px;padding-top:3px;border-radius:12px;background-color:rgb(54,60,71);color:rgb(169,177,189);-unity-text-align:middle-center;-unity-font-style:bold}.step-label{margin-top:4px;color:rgb(139,147,159);font-size:10px}.step-line{width:34px;height:2px;margin:0 2px 17px;background-color:rgb(54,60,71)}.step-active .step-number{background-color:rgb(92,61,125);color:rgb(244,232,255)}.step-active .step-label{color:rgb(224,208,244);-unity-font-style:bold}.step-done .step-number{background-color:rgb(39,91,62);color:rgb(208,246,222)}.step-done .step-label{color:rgb(150,211,172)}
.status-banner{flex-direction:row;align-items:center;margin-bottom:14px;padding:13px;border-left-width:4px;border-radius:8px;background-color:rgb(32,37,45)}.status-neutral{border-left-color:rgb(94,148,213)}.status-success{border-left-color:rgb(71,184,113);background-color:rgb(27,48,36)}.status-warning{border-left-color:rgb(224,149,66);background-color:rgb(50,41,29)}.status-error{border-left-color:rgb(218,84,81);background-color:rgb(54,31,32)}.status-icon{width:28px;height:28px;margin-right:11px;padding-top:4px;border-radius:14px;background-color:rgba(255,255,255,.08);-unity-text-align:middle-center;-unity-font-style:bold}.status-copy{flex-grow:1}.status-title{color:rgb(239,241,245);-unity-font-style:bold}.status-message{margin-top:2px;color:rgb(184,190,201);font-size:11px;white-space:normal}
.section-card,.advanced-foldout{margin-bottom:13px;padding:17px;border-width:1px;border-color:rgb(55,62,74);border-radius:10px;background-color:rgb(30,34,42)}.section-heading{flex-direction:row;margin-bottom:14px}.section-index{width:30px;height:30px;margin-right:11px;padding-top:5px;border-radius:8px;background-color:rgb(65,47,86);color:rgb(234,218,252);-unity-text-align:middle-center;-unity-font-style:bold}.section-title{color:rgb(239,241,245);font-size:15px;-unity-font-style:bold}.section-description{margin-top:2px;color:rgb(155,163,176);font-size:11px;white-space:normal}.field-stack>*{margin-bottom:8px}.field-stack .unity-base-field__label{min-width:155px;color:rgb(202,207,216)}.field-stack .unity-base-field__input{min-height:24px}
.context-card,.tip-card{margin:4px 0 11px;padding:11px;border-left-width:3px;border-left-color:rgb(105,77,140);border-radius:6px;background-color:rgb(39,34,48);color:rgb(208,197,221);white-space:normal;font-size:11px}.tip-card{margin:12px 0 0;border-left-color:rgb(182,106,255)}
.button-row{margin-top:5px}.button-wrap>*{margin:0 6px 6px 0}.grow{flex-grow:1}.primary-button,.success-button,.secondary-button,.danger-button{min-height:34px;margin-right:6px;border-radius:6px;-unity-font-style:bold}.primary-button{background-color:rgb(68,92,132);border-color:rgb(91,124,176);color:white}.success-button{background-color:rgb(43,104,67);border-color:rgb(71,153,99);color:white}.secondary-button{background-color:rgb(44,49,59);border-color:rgb(71,79,93);color:rgb(216,220,228)}.danger-button{background-color:rgb(76,42,43);border-color:rgb(126,61,62);color:rgb(244,207,207)}
.session-content{display:none}.summary-grid{flex-direction:row;flex-wrap:wrap}.summary-item{min-width:180px;margin:0 8px 8px 0;padding:9px;border-radius:6px;background-color:rgb(24,28,35)}.summary-caption{color:rgb(127,137,151);font-size:9px}.summary-value{margin-top:2px;color:rgb(229,232,237);font-size:11px;-unity-font-style:bold}.advanced-foldout{padding-top:12px}.advanced-foldout>.unity-foldout__toggle{margin-bottom:8px;-unity-font-style:bold}.foldout-help{margin-bottom:11px;color:rgb(151,160,173);font-size:11px;white-space:normal}.rule-card{margin-bottom:9px;padding:11px;border-radius:7px;background-color:rgb(24,28,35)}.rule-title{margin-bottom:8px;color:rgb(224,228,235);-unity-font-style:bold}
.validation-summary{margin-top:13px}.validation-pass,.validation-fail{padding:11px;border-radius:7px;white-space:normal}.validation-pass{background-color:rgb(27,55,39);color:rgb(193,238,208)}.validation-fail{background-color:rgb(62,34,35);color:rgb(247,202,201)}.result-list{margin-top:8px}.result-row{margin-bottom:5px;padding:8px;border-radius:5px;background-color:rgb(24,28,35);color:rgb(188,195,206);font-size:10px;white-space:normal}.result-error{border-left-width:3px;border-left-color:rgb(218,84,81)}.capture-results{margin-top:9px}.capture-path{margin-bottom:4px;color:rgb(145,178,224);font-size:10px;white-space:normal}.footer-note{margin-top:2px;color:rgb(119,127,140);font-size:10px;white-space:normal;-unity-text-align:middle-center}
@media(max-width:520px){.hero-title{font-size:19px}.step-label{display:none}.step-item{min-width:28px}.field-stack .unity-base-field__label{min-width:115px}.button-row{flex-direction:column}.button-row>*{width:100%;margin-bottom:6px}}
